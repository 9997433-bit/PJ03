{
  "name": "mortal-cultivation-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "《凡人修仙传·人生模拟器》— a text-driven xianxia life simulator. Pure client-side, seeded dice, cold Heaven's Dao narration.",
  "workspaces": [
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:all": "bash scripts/build-all.sh",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:all": "bash scripts/test-all.sh",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:all": "bash scripts/package-all.sh",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
